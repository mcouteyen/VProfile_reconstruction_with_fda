check_duplicates <- function(data){
grouped_data <- data %>%
group_by(INDEX, DEPTH) %>%
summarise(count = n(), .groups = "keep") %>%
as.data.frame()
grouped_data <- grouped_data %>% filter(count > 1)
if(nrow(grouped_data) > 0){
print("WARNING - Check for duplicated rows :")
print(grouped_data[, c("DEPTH", "INDEX")])
}
}
